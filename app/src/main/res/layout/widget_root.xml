<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_rounded_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 헤더(한 줄): 프리셋 칩 | ◀ 전월 | 연월(탭 시 연월 빠른 선택) | ▶ 다음달 | 오늘.
             손가락으로 누르기 쉽게 높이 44dp, 화살표는 48dp 폭으로 잡는다. -->
        <LinearLayout
            android:id="@+id/header_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/preset_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/preset_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/preset_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxWidth="84dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/nav_prev"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◀"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/month_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/nav_next"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▶"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/today_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="오늘"
                android:textSize="13sp" />

            <!-- 구버전 호환용 자리(보이지 않음). 앱 열기는 날짜 칸을 누르면 된다. -->
            <FrameLayout
                android:id="@+id/open_app_spacer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/short_yearmonth_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- 요일 헤더: 항상 고정이라 정적으로 선언한다 -->
        <LinearLayout
            android:id="@+id/weekday_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="7">

            <!-- 주차 번호 토글이 켜졌을 때만 보임(기본 GONE). 주 그리드의 week_number_text와 폭을 맞춘다. -->
            <TextView
                android:id="@+id/week_number_header"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                style="@style/WidgetWeekdayLabel"
                android:text="일"
                android:textColor="@color/runcal_widget_sunday" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="월" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="화" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="수" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="목" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="금" />
            <TextView
                style="@style/WidgetWeekdayLabel"
                android:text="토"
                android:textColor="@color/runcal_widget_saturday" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- 6주 그리드: RunCalWidgetRenderer가 addView로 week_row를 6번 채운다 -->
        <LinearLayout
            android:id="@+id/week_rows_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

    </LinearLayout>
</FrameLayout>
