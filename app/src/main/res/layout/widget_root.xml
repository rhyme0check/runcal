<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_rounded_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 헤더 1단: 프리셋 칩(좌) + 빈 영역(가운데, 탭 시 앱 실행) + 짧은 연월 버튼(우) -->
        <LinearLayout
            android:id="@+id/header_row1"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/preset_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/preset_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/preset_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/open_app_spacer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/short_yearmonth_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 헤더 2단: ◀ 전월 / 중앙 연월(탭 시 오늘로) / ▶ 다음달 -->
        <LinearLayout
            android:id="@+id/header_row2"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/nav_prev"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◀"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/month_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/nav_next"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▶"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- 요일 헤더: 항상 고정이라 정적으로 선언한다 -->
        <LinearLayout
            android:id="@+id/weekday_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="7">

            <!-- 주차 번호 토글이 켜졌을 때만 보임(기본 GONE). 주 그리드의 week_number_text와 폭을 맞춘다. -->
            <TextView
                android:id="@+id/week_number_header"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                style="@style/WidgetWeekdayLabel"
                android:text="일"
                android:textColor="@color/runcal_widget_sunday" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="월" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="화" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="수" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="목" />
            <TextView style="@style/WidgetWeekdayLabel" android:text="금" />
            <TextView
                style="@style/WidgetWeekdayLabel"
                android:text="토"
                android:textColor="@color/runcal_widget_saturday" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- 6주 그리드: RunCalWidgetRenderer가 addView로 week_row를 6번 채운다 -->
        <LinearLayout
            android:id="@+id/week_rows_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

    </LinearLayout>
</FrameLayout>
