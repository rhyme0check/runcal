<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 우리 자체 백업(6단계)이 이미 다루는 것들 — OS 자동 백업이 중복으로 올리지 않게 뺀다.
             runcal_database에는 Notion 캐시/토큰 관련 데이터가 없지만, 재조회 가능한 캐시성
             데이터라 애초에 클라우드 백업 대상일 필요가 없다. -->
        <exclude domain="file" path="backups/" />
        <!-- AI 명령의 변경 기록(로컬 전용). OS 자동 백업으로도 클라우드에 올라가지 않게 뺀다. -->
        <exclude domain="file" path="assistant/" />
        <exclude domain="database" path="runcal_database" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>